        "staleTime": "30 minutes",
        "description": "معدلات الضريبة"
      }
    ]
  },

  "calculationsMethods": {
    "description": "الحسابات الرئيسية في النموذج",

    "calcLineTotal": {
      "description": "حساب إجمالي السطر",
      "logic": {
        "step1": "basePrice = quantity > 1 ? price_per_pack : unit_price_ht",
        "step2": "grossAmount = basePrice × quantity",
        "step3": "discount = grossAmount × (discount_percentage / 100)",
        "step4": "ht = grossAmount - discount",
        "step5": "tva = ht × (tva_rate / 100)",
        "step6": "ttc = ht + tva",
        "step7": "fiscalStamp = calcFiscalStamp(ttc)",
        "step8": "netToPay = ttc + fiscalStamp"
      },
      "returns": {
        "basePrice": "السعر الأساسي",
        "grossAmount": "الكمية × السعر",
        "discount": "الخصم بالدينار",
        "ht": "الإجمالي HT",
        "tva": "الضريبة",
        "ttc": "الإجمالي TTC",
        "fiscalStamp": "الطابع الجبائي",
        "netToPay": "الإجمالي مع الطابع"
      }
    },

    "calcFiscalStamp": {
      "description": "حساب الطابع الجبائي وفقاً لقانون 2024",
      "logic": {
        "condition": "إذا كان ttc < 30,000 دينار",
        "return": 0,
        "else": "1% من ttc، سقف 2,500 دينار"
      },
      "formula": "if ttc < 30000 then 0 else min(ceil(ttc × 0.01), 2500)"
    },

    "findQuantityDiscount": {
      "description": "البحث عن خصم الكمية المناسب",
      "logic": {
        "step1": "تصفية الخصومات حسب price_level_id والـ active",
        "step2": "ترتيب تنازلي حسب min_qty",
        "step3": "العثور على أول خصم حيث quantity >= min_qty و quantity <= max_qty"
      }
    },

    "calcSellingPrice": {
      "description": "حساب سعر البيع حسب طريقة التسعير",
      "logic": {
        "if pricing_method is fixed": "price",
        "if pricing_method is rate": "baseCost × (1 + rate / 100)",
        "if pricing_method is margin": "baseCost + margin"
      }
    }
  },

