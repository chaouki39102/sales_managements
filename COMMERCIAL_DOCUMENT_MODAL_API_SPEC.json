      },
      {
        "name": "warehouses",
        "endpoint": "/api/v1/{company}/warehouses",
        "staleTime": "10 minutes",
        "description": "المستودعات"
      },
      {
        "name": "currencies",
        "endpoint": "/api/v1/{company}/currencies",
        "staleTime": "30 minutes",
        "description": "العملات"
      },
      {
        "name": "fiscal-years",
        "endpoint": "/api/v1/{company}/fiscal-years",
        "params": {
