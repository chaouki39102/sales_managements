        "staleTime": "5 minutes",
        "description": "السنوات المالية المفتوحة"
      },
      {
        "name": "price-levels",
        "endpoint": "/api/v1/{company}/price-levels",
        "staleTime": "30 minutes",
        "description": "مستويات الأسعار"
      },
      {
        "name": "tva-rates",
